	<Button android:id="@+id/button5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:text="ALLOW NOTIFICATIONS" android:backgroundTint="#2563EB" />
    
	<Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.1" />

</LinearLayout>