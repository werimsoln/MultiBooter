<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mb_bg"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/functionfs_back_top"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/mb_text2"
            android:textSize="30sp"
            android:textStyle="bold"
            android:background="@drawable/bg_icon_tile"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="FunctionFS Boot"
            android:textColor="@color/mb_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Userspace USB Mass Storage / Virtual CD-ROM through FunctionFS"
                android:textColor="@color/mb_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:text="The native backend handles FunctionFS events, Bulk-Only Transport and SCSI READ(10) directly in userspace."
                android:textColor="@color/mb_text2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/functionfs_support_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="13dp"
                android:background="@drawable/bg_card"
                android:text="Support has not been checked."
                android:textColor="@color/mb_text2"
                android:textSize="13sp"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/functionfs_check_support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="CHECK FUNCTIONFS SUPPORT"
                android:textColor="@color/mb_on_accent"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_primary"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:minHeight="54dp"
                android:stateListAnimator="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ISO BACKING FILE"
                    android:textColor="@color/mb_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/functionfs_iso_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:hint="/storage/emulated/0/Download/linux.iso"
                    android:textColor="@color/mb_text"
                    android:textColorHint="@color/mb_muted"
                    android:background="@drawable/bg_input"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp" />

                <Button
                    android:id="@+id/functionfs_select_iso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="SELECT ISO"
                    android:textColor="@color/mb_on_accent"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_primary"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    android:minHeight="54dp"
                    android:stateListAnimator="@null" />

                <TextView
                    android:id="@+id/functionfs_iso_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="No ISO selected."
                    android:textColor="@color/mb_text2"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IMPLEMENTATION"
                    android:textColor="@color/mb_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="• ConfigFS function: ffs.multiboot&#10;• Mount: /dev/usb-ffs/multiboot&#10;• USB class: Mass Storage 08/06/50&#10;• Transport: Bulk-Only Transport&#10;• Medium: read-only virtual CD-ROM&#10;• SCSI logical block: 2048 bytes"
                    android:textColor="@color/mb_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="13dp"
                android:background="@drawable/bg_banner_danger"
                android:text="WARNING: Requires root, ConfigFS, FunctionFS and a USB Device Controller. Starting this mode briefly unbinds and reconnects the phone's USB gadget."
                android:textColor="@color/mb_danger"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/functionfs_setup_progress"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/functionfs_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="CANCEL"
            android:textColor="@color/mb_text"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_secondary"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:minHeight="54dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/functionfs_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="START FUNCTIONFS"
            android:textColor="@color/mb_on_accent"
            android:textStyle="bold"
            android:enabled="false"
            android:alpha="0.45"
            android:background="@drawable/bg_btn_primary"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:minHeight="54dp"
            android:stateListAnimator="@null" />
    </LinearLayout>

</LinearLayout>
