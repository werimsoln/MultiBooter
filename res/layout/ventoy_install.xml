<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/mb_bg"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/ventoy_install_back_top"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/mb_text2"
            android:textSize="30sp"
            android:textStyle="bold"
            android:background="@drawable/bg_icon_tile"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Ventoy Installation"
            android:textColor="@color/mb_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.25" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:src="@drawable/ventoy_bootable_usb"
        android:scaleType="centerInside"
        android:contentDescription="Ventoy installation" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Ready to Install Ventoy"
        android:textColor="@color/mb_text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selected USB Device"
            android:textColor="@color/mb_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ventoy_install_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="USB flash drive"
            android:textColor="@color/mb_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ventoy_install_device_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Device information will be shown here."
            android:textColor="@color/mb_text2"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Partition Style"
            android:textColor="@color/mb_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/ventoy_style_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/ventoy_style_mbr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="MBR  -  works on most PCs (BIOS and UEFI)"
                android:textColor="@color/mb_text"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/ventoy_style_gpt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GPT  -  for UEFI PCs (some old BIOS PCs cannot boot it)"
                android:textColor="@color/mb_text"
                android:textSize="14sp" />
        </RadioGroup>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:padding="14dp"
        android:background="@drawable/bg_banner_warning"
        android:text="WARNING: Installing Ventoy will overwrite the selected USB drive. Existing partition data may be destroyed."
        android:textColor="@color/mb_warning"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/ventoy_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/mb_accent"
        android:progressBackgroundTint="@color/mb_surface_high" />

    <TextView
        android:id="@+id/ventoy_progress_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Ready"
        android:textColor="@color/mb_text2"
        android:textSize="14sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/ventoy_analyze_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="ANALYZE DRIVE (PARTITIONS, FREE SPACE, ISO LIST)"
        android:textColor="@color/mb_text"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_secondary"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:minHeight="54dp"
        android:stateListAnimator="@null" />

    <Button
        android:id="@+id/ventoy_update_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        android:text="UPDATE VENTOY (KEEP MY FILES)"
        android:textColor="@color/mb_on_accent"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_primary"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:minHeight="54dp"
        android:stateListAnimator="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/ventoy_install_back"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="BACK"
            android:textColor="@color/mb_text"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_secondary"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:minHeight="54dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/ventoy_install_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="INSTALL VENTOY"
            android:textColor="@color/mb_on_accent"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_primary"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:minHeight="54dp"
            android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>

</ScrollView>
