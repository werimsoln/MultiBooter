<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mb_bg"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/settings_back_top"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/mb_text2"
            android:textSize="30sp"
            android:textStyle="bold"
            android:background="@drawable/bg_icon_tile"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Settings"
            android:textColor="@color/mb_text"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Permissions"
                android:textColor="@color/mb_text"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center_horizontal"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage the permissions and system access used by MultiBooter."
                android:textColor="@color/mb_text2"
                android:textSize="13sp"
                android:gravity="center_horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ROOT ACCESS"
                    android:textColor="@color/mb_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Required only for USB Gadget, TFTP and FunctionFS boot modes."
                    android:textColor="@color/mb_text2"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/settings_root_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="NOT GRANTED"
                    android:textColor="@color/mb_danger"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/settings_root_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="GRANT ROOT ACCESS"
                    android:textColor="@color/mb_on_accent"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_primary"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    android:minHeight="54dp"
                    android:stateListAnimator="@null" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NOTIFICATIONS"
                    android:textColor="@color/mb_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Controls whether MultiBooter can show operation and status notifications."
                    android:textColor="@color/mb_text2"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/settings_notifications_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="NOT ALLOWED"
                    android:textColor="@color/mb_danger"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/settings_notifications_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="ALLOW NOTIFICATIONS"
                    android:textColor="@color/mb_on_accent"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_primary"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    android:minHeight="54dp"
                    android:stateListAnimator="@null" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BATTERY OPTIMIZATION"
                    android:textColor="@color/mb_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Disabling battery optimization helps long-running boot and server operations remain active."
                    android:textColor="@color/mb_text2"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/settings_battery_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="OPTIMIZATION ENABLED"
                    android:textColor="@color/mb_danger"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/settings_battery_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="DISABLE OPTIMIZATION"
                    android:textColor="@color/mb_on_accent"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_primary"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    android:minHeight="54dp"
                    android:stateListAnimator="@null" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
