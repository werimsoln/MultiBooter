<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#0B305A">
    
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">

            <ImageView android:id="@+id/btn_menu" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_hamburger" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:contentDescription="Menü" />

            <TextView android:id="@+id/text_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MultiBooter" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:layout_marginStart="16dp" />

        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose booting method" android:textSize="22sp" android:gravity="center_horizontal" android:textStyle="bold" android:textColor="#FFFFFF" android:paddingBottom="16dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <LinearLayout android:id="@+id/card_usb" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:clickable="true" android:focusable="true" android:background="#123A63">

                <ImageView android:id="@+id/image_usb_boot" android:layout_width="80dp" android:layout_height="60dp" android:src="@drawable/ventoy_bootable_usb" android:scaleType="centerInside" android:contentDescription="Create an USB bootable media with Ventoy (No Root Required)" />

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:text="Create Bootable USB Media with Ventoy (No Root Required)" android:textSize="17sp" android:textStyle="bold" android:textColor="#D7EEFF" />

            </LinearLayout>

            <LinearLayout android:id="@+id/card_usb2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:clickable="true" android:focusable="true" android:background="#164A59">

                <ImageView android:id="@+id/image_usb_boot2" android:layout_width="80dp" android:layout_height="60dp" android:src="@drawable/cdrom_to_usb" android:scaleType="centerInside" android:contentDescription="Write Bootable CD-ROM to USB (No Root Required)" />

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:text="Write Bootable CD-ROM to USB (No Root Required)" android:textSize="17sp" android:textStyle="bold" android:textColor="#D5F5FA" />

            </LinearLayout>

            <LinearLayout android:id="@+id/card_gadget" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:clickable="false" android:focusable="true" android:background="#15504F">

                <ImageView android:id="@+id/image_gadget" android:layout_width="80dp" android:layout_height="60dp" android:src="@drawable/boot_gadget" android:scaleType="centerInside" android:contentDescription="Boot directly from device" />

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:text="Boot directly from device with USB Gadget Mode (Root Required)" android:textSize="17sp" android:textStyle="bold" android:textColor="#CFFAF5" />

            </LinearLayout>

            <LinearLayout android:id="@+id/card_tftp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:clickable="false" android:focusable="true" android:background="#17483D">

                <ImageView android:id="@+id/image_tftp" android:layout_width="80dp" android:layout_height="60dp" android:src="@drawable/boot_tftp" android:scaleType="centerInside" android:contentDescription="Boot directly from device with TFTP server (Root Required)" />

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:text="Boot directly from device with TFTP Server (Root Required)" android:textSize="17sp" android:textStyle="bold" android:textColor="#D9E8F5" />

            </LinearLayout>

            <LinearLayout android:id="@+id/card_extra" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:clickable="true" android:focusable="true" android:background="#2E1A47">

                <ImageView android:id="@+id/image_ffs" android:layout_width="80dp" android:layout_height="60dp" android:src="@drawable/boot_gadget" android:scaleType="centerInside" android:contentDescription="FunctionFS Mode" />

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:text="Boot directly from device with FunctionFS (Root Required)" android:textSize="17sp" android:textStyle="bold" android:textColor="#E9D8FD" />

            </LinearLayout>

        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

            <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.2" />

            <Button android:id="@+id/boot_continue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.6" android:text="CONTINUE" android:textStyle="bold" android:textColor="#FFFFFF" android:backgroundTint="#2563EB" />

            <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.2" />

        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2" />

    </LinearLayout>

    <View android:id="@+id/drawer_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#80000000" android:visibility="gone" />

    <LinearLayout android:id="@+id/side_drawer" android:layout_width="260dp" android:layout_height="match_parent" android:layout_gravity="start" android:background="#0F172A" android:orientation="vertical" android:padding="16dp" android:visibility="gone">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MultiBooter" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" android:paddingBottom="4dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="v0.1.0 (1000)" android:textColor="#BAE6FD" android:textSize="12sp" android:paddingBottom="24dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E293B" android:layout_marginBottom="16dp" />

        <TextView android:id="@+id/menu_item_usb" android:drawableStart="@drawable/ic_home" android:drawablePadding="12dp" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Homepage" android:textColor="#E2E8F0" android:textSize="16sp" android:padding="12dp" android:background="?android:attr/selectableItemBackground" android:clickable="true" />

        <TextView android:id="@+id/menu_item_gadget" android:drawableStart="@drawable/ic_settings" android:drawablePadding="12dp" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Settings" android:textColor="#E2E8F0" android:textSize="16sp" android:padding="12dp" android:background="?android:attr/selectableItemBackground" android:clickable="true" />

        <TextView android:id="@+id/menu_item_tftp" android:drawableStart="@drawable/ic_about" android:drawablePadding="12dp" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="About" android:textColor="#E2E8F0" android:textSize="16sp" android:padding="12dp" android:background="?android:attr/selectableItemBackground" android:clickable="true" />

        <TextView android:id="@+id/menu_item_bmc" android:drawableStart="@drawable/ic_coffee" android:drawablePadding="12dp" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Buy Me a Coffee" android:textColor="#E2E8F0" android:textSize="16sp" android:padding="12dp" android:background="?android:attr/selectableItemBackground" android:clickable="true" />

        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    </LinearLayout>

</FrameLayout>