<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mb_bg"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tftp_back_top"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/mb_text2"
            android:textSize="30sp"
            android:textStyle="bold"
            android:background="@drawable/bg_icon_tile"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="PXE / TFTP Boot"
            android:textColor="@color/mb_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Root dnsmasq DHCP + TFTP server for PXE boot"
                android:textColor="@color/mb_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tftp_dnsmasq_abi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="12dp"
                android:background="@drawable/bg_card"
                android:text="Host ABI"
                android:textColor="@color/mb_text2"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NETWORK INTERFACE"
                    android:textColor="@color/mb_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/tftp_interface"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="4dp"
                    android:spinnerMode="dropdown"
                    android:backgroundTint="@color/mb_text2" />

                <Button
                    android:id="@+id/tftp_refresh_interfaces"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="REFRESH INTERFACES"
                    android:textColor="@color/mb_on_accent"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_primary"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    android:minHeight="54dp"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TFTP ROOT"
                    android:textColor="@color/mb_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/tftp_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:hint="/sdcard/Download/tftp"
                    android:textColor="@color/mb_text"
                    android:textColorHint="@color/mb_muted"
                    android:background="@drawable/bg_input"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp" />

                <Button
                    android:id="@+id/tftp_create_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="CREATE TFTP ROOT"
                    android:textColor="@color/mb_on_accent"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_primary"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    android:minHeight="54dp"
                    android:stateListAnimator="@null" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="BOOT FILE — relative to TFTP root"
                    android:textColor="@color/mb_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/tftp_boot_file"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:hint="pxelinux.0"
                    android:textColor="@color/mb_text"
                    android:textColorHint="@color/mb_muted"
                    android:background="@drawable/bg_input"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Legacy example: pxelinux.0\nUEFI example: bootx64.efi or the distribution-specific EFI loader path."
                    android:textColor="@color/mb_text2"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PXE NETWORK"
                    android:textColor="@color/mb_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/tftp_server_ip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:singleLine="true"
                    android:inputType="phone"
                    android:hint="192.168.2.1"
                    android:textColor="@color/mb_text"
                    android:textColorHint="@color/mb_muted"
                    android:background="@drawable/bg_input"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp" />

                <EditText
                    android:id="@+id/tftp_dhcp_start"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:singleLine="true"
                    android:inputType="phone"
                    android:hint="192.168.2.10"
                    android:textColor="@color/mb_text"
                    android:textColorHint="@color/mb_muted"
                    android:background="@drawable/bg_input"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp" />

                <EditText
                    android:id="@+id/tftp_dhcp_end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:singleLine="true"
                    android:inputType="phone"
                    android:hint="192.168.2.100"
                    android:textColor="@color/mb_text"
                    android:textColorHint="@color/mb_muted"
                    android:background="@drawable/bg_input"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="13dp"
                android:background="@drawable/bg_banner_danger"
                android:text="WARNING: Requires root. Use a dedicated Ethernet/USB network segment. Starting another DHCP server on an existing LAN can disrupt that network."
                android:textColor="@color/mb_danger"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/tftp_setup_progress"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/tftp_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="CANCEL"
            android:textColor="@color/mb_text"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_secondary"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:minHeight="54dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/tftp_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="START PXE"
            android:textColor="@color/mb_on_accent"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_primary"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:minHeight="54dp"
            android:stateListAnimator="@null" />
    </LinearLayout>

</LinearLayout>
